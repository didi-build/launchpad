{
  "name": "launchpad",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub template: repo hygiene, docs, agent instructions, and quality gates for new projects.",
  "license": "UNLICENSED",
  "launchpadTemplate": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run secrets && npm run placeholders",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "secretlint \"**/*\"",
    "placeholders": "node scripts/check-placeholders.mjs",
    "init-project": "node scripts/init-project.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@types/node": "22.18.8",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "secretlint": "10.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "5.0.3"
  }
}
